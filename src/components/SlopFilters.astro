---
// Shared filter primitives for the `.slop-displace` utility class (see
// src/styles/slop-effects.css). A single hidden <svg><filter> def, referenced
// by id, so every consumer pays for one turbulence pass rather than each
// carrying its own copy. Render this once per page, anywhere in the body,
// before the first element that uses `.slop-displace`.
---

<svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
  <filter id="slop-displacement" x="-20%" y="-20%" width="140%" height="140%">
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.012 0.04"
      numOctaves="2"
      seed="7"
      result="slop-noise"
    ></feTurbulence>
    <feDisplacementMap
      in="SourceGraphic"
      in2="slop-noise"
      scale="6"
      xChannelSelector="R"
      yChannelSelector="G"
    ></feDisplacementMap>
  </filter>
</svg>
